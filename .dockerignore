# 密钥与本地配置：绝不能进镜像（COPY . /app 会带上整个构建上下文）
.env
.env.*
!.env.example

# 版本控制
.git
.gitignore

# Python 缓存与测试产物
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# 构建快照与运行期产物
hf_space_build/
traces/
*.log

# 本地虚拟环境
.venv/
venv/
envs/
_ci_check/

# 前端依赖与运行无关文件：避免打进运行镜像（COPY . /app 会带整个构建上下文）
#   node_modules/：playwright-core 等前端截图依赖，运行镜像完全用不到
#   tests/ scripts/ docs/：测试、构建脚本、文档均非运行期产物
node_modules/
tests/
scripts/
docs/
