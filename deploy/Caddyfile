# TeleOps Caddy 反向代理 + 自动 HTTPS
# - 域名来自环境变量 {$TELEOPS_DOMAIN}（compose 注入）
# - localhost 时 Caddy 用内部 CA 自签（本地自测，浏览器需信任该 CA 或直接忽略警告）
# - 真实域名时自动向 Let's Encrypt 申请/续期证书
# - backend 单端口同时提供 API 与静态界面，全部反代到 backend:8000

{
    # 公网证书申请（Let's Encrypt）需要联系邮箱；非交互式容器环境必须在此给定，
    # 否则 Caddy 首跑会卡在交互式询问。留空时回退占位值（生产请务必填真实邮箱）。
    email {$TELEOPS_ACME_EMAIL:admin@localhost}
    servers {
        trusted_proxies static private_ranges
    }
}

{$TELEOPS_DOMAIN} {
    encode gzip

    # 流式输出（diagnose/build 的 markdown 流式）实时刷新，不缓冲
    reverse_proxy backend:8000 {
        flush_interval -1
    }
}
