# ===== TeleOps 部署密钥样例 =====
# 复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 忽略，不会入库）

# 【必填】DeepSeek API Key（实时 LLM）。不填则自动降级为离线 Mock，Demo 仍可用
DEEPSEEK_API_KEY=your_deepseek_key_here

# 【必填】对外访问域名。
#   本地自测：填 localhost（Caddy 用内部 CA 自签，浏览器忽略警告即可）
#   公网生产：填真实域名，如 teleops.example.com（需先将该域名 A 记录指向本机公网 IP）
TELEOPS_DOMAIN=localhost

# 【可选】API 写接口 Token 鉴权。设置后，所有 POST/PUT/DELETE 必须带此 Token；
#   前端「设置」里填相同值即可自动携带。强烈建议公网部署时设置。
#   留空 = 写接口完全开放（仅适合内网 / 纯演示）
TELEOPS_API_TOKEN=

# 【可选】允许的前端跨域来源（逗号分隔）。同源部署（Caddy 同域）通常无需设置；
#   若前端独立域名，填 https://your-frontend.com
TELEOPS_CORS_ORIGINS=

# 【可选】启用 Chroma 向量检索（知识库 RAG）。需镜像内已装 chromadb（见 deploy/requirements.txt 注释）
#   默认 0 = 本地关键词检索（零额外依赖）
USE_CHROMA=0

# 【可选】限流开关与阈值（Phase 3）。默认 on。
#   TELEOPS_RATE_LIMIT=on|off
#   读接口 300 次/分/IP、写接口 60 次/分/IP、登录注册 10 次/分/IP（防口令爆破）
TELEOPS_RATE_LIMIT=on
# TELEOPS_RATE_LIMIT_READ=300
# TELEOPS_RATE_LIMIT_WRITE=60
# TELEOPS_RATE_LIMIT_LOGIN=10

# 【可选】Grafana 管理员（observability profile）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
