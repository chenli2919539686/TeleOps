.venv/
__pycache__/
*.pyc
.env
.chroma/
# 部署密钥（含敏感信息，绝不入库）
deploy/.env
**/.env
# 大型原始公开日志下载不入库（用 ingest_public.py --download 重新拉取）
data/raw/*_2k.log
# SQLite 数据库与运行时 LLM 配置（不入库）
data/teleops.db
data/teleops.db-journal
data/teleops.db-wal
data/teleops.db-shm
data/llm_config.json
# 运行期 LLM 用量统计（含每日花费流水，非源码）
data/llm_usage.json
# 适配器真实连接配置（外部系统地址/凭据，非源码；示例见 data/adapters.example.json）
data/adapters.json
logs/
# 构建快照（scripts/build_hf_space.py 生成，非源码）
hf_space_build/
# 运行期 trace 记录（调试产物，非源码）
traces/
# Node 依赖（前端截图脚本运行时下载）
node_modules/
# Caddy HTTPS 反代运行时二进制与下载缓存（caddy_setup.py 管理）
tools/caddy.exe
tools/*.zip
# 后端 + Caddy PID 文件与运行时配置（运行期产物）
data/.server.pid
data/.caddy.pid
data/.caddy.Caddyfile
# JWT 注销黑名单（运行期持久化，含 jti，非源码）
data/jwt_revoked.json
# 运行期日志（后端 / Caddy 输出）
data/caddy.log
data/teleops_server.log
data/caddy_server.log
# 重置/备份产物（scripts 类操作生成）
data/_reset_*/
data/teleops.db.bak-*
